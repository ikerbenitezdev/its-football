---
interface Props {
  number: string;
  title: string;
  description: string;
  href: string;
  label: string;
}

const { number, title, description, href, label } = Astro.props;
---

<article class="service-card reveal">
  <span class="service-number" aria-hidden="true">{number}</span>
  <h3>{title}</h3>
  <p>{description}</p>
  <a href={href} aria-label={`${label}: ${title}`}>
    {label}<span aria-hidden="true"> ↗</span>
  </a>
</article>