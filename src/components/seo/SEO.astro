---
import { getLocalizedPath, type Locale, type RouteKey } from '../../i18n';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  route: RouteKey;
  image?: string;
  noindex?: boolean;
}

const { title, description, locale, route, image = '/social-card.svg', noindex = false } = Astro.props;
const siteUrl = Astro.site ?? new URL('https://itsfootball.example');
const canonical = new URL(getLocalizedPath(route, locale), siteUrl).href;
const englishUrl = new URL(getLocalizedPath(route, 'en'), siteUrl).href;
const spanishUrl = new URL(getLocalizedPath(route, 'es'), siteUrl).href;
const imageUrl = new URL(image, siteUrl).href;
const ogLocale = locale === 'es' ? 'es_ES' : 'en_US';
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex,follow" />}
{!noindex && <link rel="canonical" href={canonical} />}
{!noindex && <link rel="alternate" hreflang="en" href={englishUrl} />}
{!noindex && <link rel="alternate" hreflang="es" href={spanishUrl} />}
{!noindex && <link rel="alternate" hreflang="x-default" href={englishUrl} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="it's football" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_ES'} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="theme-color" content="#27527f" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.svg" type="image/svg+xml" />